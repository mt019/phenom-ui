{
  "name": "@phenomcanvas/ui",
  "version": "0.1.27",
  "description": "Versioned UI, design tokens, web fonts, shells, SEO helpers, and validators for Phenom sites.",
  "type": "module",
  "sideEffects": [
    "./src/styles.css",
    "./src/styles/*.css"
  ],
  "files": [
    "src",
    "assets",
    "fonts",
    "scripts",
    "tailwind-preset.js",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.js",
    "./styles.css": "./src/styles.css",
    "./eyebrow": "./src/components/Eyebrow.jsx",
    "./tokens.css": "./src/styles/tokens.css",
    "./tailwind-preset": "./tailwind-preset.js",
    "./math": "./src/components/lab/Math.jsx",
    "./prose": "./src/components/lab/Prose.jsx",
    "./assets/*": "./assets/*",
    "./fonts/*": "./fonts/*",
    "./validators/*": "./scripts/*"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-package.mjs && node scripts/validate-font-subsets.mjs && node scripts/validate-design-tokens.mjs && node scripts/validate-color-system.mjs && node scripts/validate-floating-surfaces.mjs && npm test",
    "prepack": "npm run validate"
  },
  "peerDependencies": {
    "@mdx-js/react": "^3.1.1",
    "katex": "^0.17.0",
    "lucide-react": ">=0.400.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-router-dom": "^6.22.3 || ^7.0.0"
  },
  "devDependencies": {
    "@mdx-js/react": "^3.1.1",
    "esbuild": "^0.25.0",
    "fontkit": "^2.0.4",
    "katex": "^0.17.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "license": "MIT"
}
